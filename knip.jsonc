{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // shadcn components are generated whole: their imports count, their unused exports are the CLI's business.
  "entry": [
    "src/components/ui/**/*.tsx",
    "tests/e2e/auth.setup.ts",
    "prisma/seed.ts",
    "scripts/*.ts",
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "@prisma/client",
    "tw-animate-css",
    "cn",
    "@tailwindcss/postcss",
    "shadcn",
    "dotenv",
  ],
}
