# Copy to .env and fill in. NEVER commit .env. Placeholders only here.

# --- Database (docker compose publishes Postgres on 127.0.0.1:54340) ---
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://site:change-me@localhost:54340/site
# Integration tests refuse any database whose name does not contain "test".
DATABASE_URL_TEST=postgresql://site:change-me@localhost:54340/site_test

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Auth.js v5 ---
# openssl rand -base64 33
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Only this e-mail can sign in to /admin.
ADMIN_EMAIL=
# Password login (local/dev or if you do not want OAuth). Generate with: pnpm auth:hash "your password"
ADMIN_PASSWORD_HASH=
# GitHub OAuth (optional; callback: <site>/api/auth/callback/github)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# --- Storage: "local" (default) or "s3" ---
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR=./storage-data
# Public base URL that serves stored files (CloudFront / custom domain). Local default serves via /api/media.
STORAGE_PUBLIC_BASE_URL=
# S3 (only when STORAGE_DRIVER=s3). See docs/PHOTOS-AWS-SETUP.md
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# Set only for MinIO / other S3-compatible services (e.g. http://localhost:9000)
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false

# --- Contact form e-mail (optional: messages are always stored in the DB) ---
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=
